pipeline {
    agent any

    environment {
        VIRTUAL_ENV = 'venv'
        PYTHON = 'C:\\Users\\Victus\\AppData\\Local\\Programs\\Python\\Python312\\python.exe'
    }

    stages {
        stage('Setup') {
            steps {
                script {
                    if (!fileExists("${env.WORKSPACE}/${VIRTUAL_ENV}")) {
                        bat "\"%PYTHON%\" -m venv %VIRTUAL_ENV%"
                    }
                    bat "%VIRTUAL_ENV%\\Scripts\\python -m pip install -r requirements.txt"
                }
            }
        }
        stage('Lint') {
            steps {
                script {
                    bat "%VIRTUAL_ENV%\\Scripts\\python -m flake8 app.py"
                }
            }
        }
        stage('Test') {
            steps {
                script {
                    bat "%VIRTUAL_ENV%\\Scripts\\python -m pytest"
                }
            }
        }
        stage('Deploy') {
            steps {
                script {
                    echo "Deploying application..."
                }
            }
        }
    }

    post {
        always {
            cleanWs()
        }
    }
}